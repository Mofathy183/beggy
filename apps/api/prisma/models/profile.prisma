/// User profile containing public and user-editable information.
///
/// Separated from the User model to enforce clear security
/// and responsibility boundaries.
model Profile {
    /// Primary identifier for the profile.
    id String @id @default(uuid())

    /// Identifier of the associated user.
    /// Foreign key to User (1:1)
    userId String @unique @map("user_id")

    /// Relation to the owning user.
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    /// User first name.
    firstName String @map("first_name") @db.VarChar(50)

    /// User last name.
    lastName String @map("last_name") @db.VarChar(50)

    /// Public avatar image URL (managed externally).
    avatarUrl String? @db.VarChar(2048)

    /// Optional gender information.
    gender Gender?

    /// Optional birth date.
    birthDate DateTime?

    /// Optional country.
    country String? @db.VarChar(100)

    /// Optional city.
    city String? @db.VarChar(100)

    /// Indicates whether the user has completed or dismissed the optional onboarding flow.
    /// Used by the frontend to decide whether to show Soft Nudge onboarding hints.
    onboardingCompleted Boolean @default(false) @map("onboarding_completed")

    /// Profile creation timestamp.
    createdAt DateTime @default(now())

    /// Profile update timestamp.
    updatedAt DateTime @updatedAt

    /// Database table name.
    @@map("profiles")
}
